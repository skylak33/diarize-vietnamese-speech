{
  "schema_version": 1,
  "seed": 42,
  "scenario": "clean",
  "target_counts": {
    "development": 300,
    "validation": 150,
    "holdout": 150
  },
  "speaker_counts": [1, 2, 3, 4, 5],
  "duration_seconds": {
    "min": 30.0,
    "max": 45.0
  },
  "turn_seconds": {
    "min": 3.0,
    "max": 8.0
  },
  "silence_seconds": {
    "min": 0.3,
    "max": 1.0
  },
  "sample_rate_hz": 16000,
  "noise": false,
  "overlap": false,
  "transformations": [],
  "max_sources_per_speaker": 12,
  "vad": {
    "threshold": 0.5,
    "min_speech_ms": 250,
    "min_silence_ms": 100,
    "speech_pad_ms": 30
  },
  "split_policy": {
    "dnu_vispeech": "train=development,validation=validation,test=holdout",
    "vietnamese_asr": "test=holdout; train speakers hash-assigned 2/3 development, 1/3 validation",
    "viespeaker": "speakers hash-assigned 1/2 development, 1/4 validation, 1/4 holdout"
  }
}
